{
  "name": "env",
  "version": "1.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "env",
      "version": "1.0.0",
      "license": "MIT",
      "workspaces": [
        "packages/feltdb-core",
        "packages/appport-sdk"
      ]
    },
    "node_modules/@appport/sdk": {
      "resolved": "packages/appport-sdk",
      "link": true
    },
    "node_modules/@feltdb/core": {
      "resolved": "packages/feltdb-core",
      "link": true
    },
    "packages/appport-sdk": {
      "name": "@appport/sdk",
      "version": "0.1.0",
      "license": "MIT",
      "dependencies": {
        "@feltdb/core": "0.1.0"
      },
      "bin": {
        "appport": "bin/appport.js"
      }
    },
    "packages/feltdb-core": {
      "name": "@feltdb/core",
      "version": "0.1.0",
      "license": "MIT"
    }
  }
}
